# Copie para .env e preencha com as chaves públicas do projeto (nunca commitar .env)
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Versão exibida no modal de atualização PWA (opcional)
# VITE_APP_VERSION=20260726a

# Edge/API de Open Graph (/api/og-loja) — no Lovable Cloud/Vercel use as mesmas chaves públicas
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# Prévia administrativa JF: somente leitura; ativar apenas na homologação do Orus.
# Não substitua as variáveis SUPABASE acima: o banco do Orus continua independente.
VITE_JF_CATALOG_PREVIEW_ENABLED=false
VITE_JF_SUPABASE_PUBLISHABLE_KEY=
